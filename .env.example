APP_NAME=AdScope
APP_ENV=development
DEBUG=true

APP_USERNAME=admin
APP_PASSWORD=change-me
SESSION_SECRET=change-this-secret
COOKIE_SECURE=false

DATABASE_URL=sqlite:///./data/adscope.db

DEMO_MODE=true
LLM_TIMEOUT_SECONDS=60

# Providers are optional. Each one is enabled only when its API key is set.
# Leave DEMO_MODE=true to run without any real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
