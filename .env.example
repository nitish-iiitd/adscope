APP_NAME=AdScope
APP_ENV=development
DEBUG=true

APP_USERNAME=admin
APP_PASSWORD=change-me
SESSION_SECRET=change-this-secret
COOKIE_SECURE=false

DATABASE_URL=sqlite:///./data/adscope.db

DEMO_MODE=true
LLM_TIMEOUT_SECONDS=60

# Pipeline tunables. These are the DEFAULTS; a campaign can override every one
# except LLM_CONCURRENCY per-run from the New Campaign form.
QUERIES_PER_PROVIDER=10      # service-1: queries each model drafts (combined = models x this)
MAX_WEBSITES_PER_QUERY=10    # service-2: max websites a model returns per query
MAX_YOUTUBE_PER_QUERY=10     # service-2: max YouTube channels a model returns per query
MAX_APPS_PER_QUERY=10        # service-2: max apps a model returns per query
MAX_FINAL_WEBSITES=50        # cap on the final ranked list, applied per publisher type
LLM_CONCURRENCY=8            # max concurrent provider calls (global, not per-campaign)

# How often the two waiting pages (query generation, discovery) auto-refresh.
POLL_INTERVAL_SECONDS=10

# Providers are optional. Each one is enabled only when its API key is set.
# Leave DEMO_MODE=true to run without any real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
